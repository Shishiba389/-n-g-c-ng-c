{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "an-gi-cung-duoc-counter",
  "main": "worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "an-gi-cung-duoc-counter",
      "migrations_dir": "migrations",
      "database_id": "0a232e5c-1082-4cbe-ad9a-063387678b30"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://shishiba389.github.io"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    }
  }
}
